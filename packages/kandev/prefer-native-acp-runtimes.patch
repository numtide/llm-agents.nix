diff --git a/apps/backend/internal/agent/agents/native_binary_agents_test.go b/apps/backend/internal/agent/agents/native_binary_agents_test.go
new file mode 100644
index 000000000..2eb855455
--- /dev/null
+++ b/apps/backend/internal/agent/agents/native_binary_agents_test.go
@@ -0,0 +1,54 @@
+package agents
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestNPMACPAgentsPreferNativeBinary(t *testing.T) {
+	tests := []struct {
+		name, binary string
+		agent        Agent
+		// A nil fallback expects the agent's managed npm runtime cached command,
+		// which pins the reviewed default version.
+		native, fallback []string
+	}{
+		{"opencode", "opencode", NewOpenCodeACP(), []string{"opencode", "acp", "--print-logs"}, nil},
+		{"copilot", "copilot", NewCopilotACP(), []string{"copilot", "--acp"}, nil},
+		{"gemini", "gemini", NewGemini(), []string{"gemini", "--acp"}, nil},
+		{"droid", "droid", NewDroidACP(), []string{"droid", "exec", "--output-format", "acp"}, []string{"npx", "-y", "droid", "exec", "--output-format", "acp"}},
+		{"kilocode", "kilocode", NewKilocodeACP(), []string{"kilocode", "acp"}, []string{"npx", "-y", "@kilocode/cli", "acp"}},
+		{"qwen", "qwen", NewQwenACP(), []string{"qwen", "--acp"}, []string{"npx", "-y", "@qwen-code/qwen-code", "--acp"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			n, ok := tt.agent.(NativeBinaryAgent)
+			if !ok {
+				t.Fatal("missing NativeBinaryAgent")
+			}
+			if got := n.NativeBinaryName(); got != tt.binary {
+				t.Fatalf("binary = %q, want %q", got, tt.binary)
+			}
+			if got := tt.agent.BuildCommand(CommandOptions{PreferNativeBinary: true}).Args(); !slices.Equal(got, tt.native) {
+				t.Fatalf("native = %#v, want %#v", got, tt.native)
+			}
+			fallback := tt.fallback
+			if fallback == nil {
+				fallback = tt.agent.(ManagedNPMRuntimeAgent).ManagedNPMRuntime().CachedACPCommand().Args()
+			}
+			if got := tt.agent.BuildCommand(CommandOptions{}).Args(); !slices.Equal(got, fallback) {
+				t.Fatalf("fallback = %#v, want %#v", got, fallback)
+			}
+		})
+	}
+}
+
+func TestManagedNPMACPAgentsKeepExactPinFallback(t *testing.T) {
+	for _, a := range []Agent{NewOpenCodeACP(), NewCopilotACP(), NewGemini()} {
+		want := a.(ManagedNPMRuntimeAgent).ManagedNPMRuntime().ACPCommand("1.2.3").Args()
+		got := a.BuildCommand(CommandOptions{ManagedRuntimeVersion: "1.2.3"}).Args()
+		if !slices.Equal(got, want) {
+			t.Fatalf("%s fallback = %#v, want %#v", a.ID(), got, want)
+		}
+	}
+}
diff --git a/apps/backend/internal/agent/agents/opencode_acp.go b/apps/backend/internal/agent/agents/opencode_acp.go
index e4e6fed99..510c228ee 100644
--- a/apps/backend/internal/agent/agents/opencode_acp.go
+++ b/apps/backend/internal/agent/agents/opencode_acp.go
@@ -92,12 +92,39 @@ func (a *OpenCodeACP) ResolveSelectedRuntimeWithReader(
 	if version == "" {
 		version = selection.AppliedDefaultVersion
 	}
-	return OpenCodeRuntimeResolution{
+	resolved := OpenCodeRuntimeResolution{
 		Family:  selection.Family,
 		Source:  selection.Source,
 		Spec:    spec,
 		Version: version,
-	}, nil
+	}
+	return a.preferHostNativeRuntime(ctx, resolved), nil
+}
+
+// detectOpenCodeNativeForSelection is swapped in tests.
+var detectOpenCodeNativeForSelection = DetectOpenCodeNativeRuntime
+
+// preferHostNativeRuntime selects a supported opencode executable on PATH over
+// the stored selection. Managed npm runtimes ship FHS-linked binaries that
+// cannot run on hosts without an FHS dynamic loader (such as NixOS), so the
+// host-provided CLI wins whenever it reports a supported version. Detection
+// failures keep the stored selection so existing fail-closed checks apply.
+func (a *OpenCodeACP) preferHostNativeRuntime(ctx context.Context, resolved OpenCodeRuntimeResolution) OpenCodeRuntimeResolution {
+	native, found, err := detectOpenCodeNativeForSelection(ctx)
+	if err != nil || !found {
+		return resolved
+	}
+	if native.Family != resolved.Family {
+		spec, err := a.ManagedNPMRuntimeForFamily(native.Family)
+		if err != nil {
+			return resolved
+		}
+		resolved.Family = native.Family
+		resolved.Spec = spec
+		resolved.Version = spec.DefaultVersionOrPinned()
+	}
+	resolved.Source = managedruntime.OpenCodeSourceNative
+	return resolved
 }
 
 func NewOpenCodeACP() *OpenCodeACP {
