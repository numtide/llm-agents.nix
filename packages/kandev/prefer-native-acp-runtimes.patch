 	opts := agents.CommandOptions{
 		Runtime:               agentruntime.RuntimeStandalone,
+		PreferNativeBinary:    preferNative,
 		ManagedRuntimeVersion: managedRuntimeVersion,
 	}
 	cmd := ag.BuildCommand(opts)
