@@ -0,0 +1,82 @@
+package agents
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/kandev/kandev/internal/agent/managedruntime"
+)
+
+type hostNativeSelectionReader struct {
+	selection managedruntime.OpenCodeSelection
+}
+
+func (r hostNativeSelectionReader) GetOpenCodeSelection(context.Context) (managedruntime.OpenCodeSelection, bool, error) {
+	return r.selection, true, nil
+}
+
+func stubOpenCodeNativeDetection(t *testing.T, native OpenCodeNativeRuntime, found bool, err error) {
+	t.Helper()
+	previous := detectOpenCodeNativeForSelection
+	detectOpenCodeNativeForSelection = func(context.Context) (OpenCodeNativeRuntime, bool, error) {
+		return native, found, err
+	}
+	t.Cleanup(func() { detectOpenCodeNativeForSelection = previous })
+}
+
+func managedV1Selection() managedruntime.OpenCodeSelection {
+	return managedruntime.OpenCodeSelection{
+		SchemaVersion: 1, Family: managedruntime.OpenCodeFamilyV1, Source: managedruntime.OpenCodeSourceManaged,
+		Package: managedruntime.OpenCodeV1Package, SelectedVersion: "1.18.5", AppliedDefaultVersion: "1.18.5", Revision: 1,
+	}
+}
+
+func TestResolveSelectedRuntimePrefersHostNativeOpenCode(t *testing.T) {
+	stubOpenCodeNativeDetection(t, OpenCodeNativeRuntime{Family: managedruntime.OpenCodeFamilyV2, Version: "2.1.0"}, true, nil)
+
+	got, err := NewOpenCodeACP().ResolveSelectedRuntimeWithReader(context.Background(), hostNativeSelectionReader{managedV1Selection()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Source != managedruntime.OpenCodeSourceNative || got.Family != managedruntime.OpenCodeFamilyV2 {
+		t.Fatalf("resolution = %s/%s, want native/v2", got.Source, got.Family)
+	}
+	if got.Spec.Package != managedruntime.OpenCodeV2Package {
+		t.Fatalf("spec package = %q, want %q", got.Spec.Package, managedruntime.OpenCodeV2Package)
+	}
+}
+
+func TestResolveSelectedRuntimeKeepsSelectedVersionForSameNativeFamily(t *testing.T) {
+	stubOpenCodeNativeDetection(t, OpenCodeNativeRuntime{Family: managedruntime.OpenCodeFamilyV1, Version: "1.19.0"}, true, nil)
+
+	got, err := NewOpenCodeACP().ResolveSelectedRuntimeWithReader(context.Background(), hostNativeSelectionReader{managedV1Selection()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Source != managedruntime.OpenCodeSourceNative || got.Family != managedruntime.OpenCodeFamilyV1 || got.Version != "1.18.5" {
+		t.Fatalf("resolution = %s/%s@%s, want native/v1@1.18.5", got.Source, got.Family, got.Version)
+	}
+}
+
+func TestResolveSelectedRuntimeKeepsSelectionWithoutUsableHostOpenCode(t *testing.T) {
+	for name, detect := range map[string]struct {
+		found bool
+		err   error
+	}{
+		"missing": {},
+		"broken":  {found: true, err: errors.New("version probe failed")},
+	} {
+		t.Run(name, func(t *testing.T) {
+			stubOpenCodeNativeDetection(t, OpenCodeNativeRuntime{}, detect.found, detect.err)
+
+			got, err := NewOpenCodeACP().ResolveSelectedRuntimeWithReader(context.Background(), hostNativeSelectionReader{managedV1Selection()})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.Source != managedruntime.OpenCodeSourceManaged || got.Family != managedruntime.OpenCodeFamilyV1 {
+				t.Fatalf("resolution = %s/%s, want managed/v1", got.Source, got.Family)
+			}
+		})
+	}
+}
