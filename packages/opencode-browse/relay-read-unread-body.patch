+/// The answer while the relay is starting, or to a local request whose Host isn't the relay's.
+fn refusal<B>(relay: &Relay, local: bool, request: &Request<B>) -> Option<Response<Full<Bytes>>> {
+    if !relay.ready.load(Ordering::SeqCst) {
+        return Some(json_response(StatusCode::SERVICE_UNAVAILABLE, &json!({ "error": "browse relay is starting", "code": "relay-starting" })));
+    }
+    if local
+        && let Err(error) = crate::origins::validate_host_header(header(request, "host"), &relay.host, relay.port) {
+            return Some(json_response(StatusCode::FORBIDDEN, &json!({ "error": error })));
+        }
+    None
+}
