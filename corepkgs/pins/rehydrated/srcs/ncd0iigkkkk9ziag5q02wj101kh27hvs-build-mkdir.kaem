${M2} --architecture amd64 \
  -f ${m2libc}/sys/types.h \
  -f ${m2libc}/stddef.h \
  -f ${m2libc}/sys/utsname.h \
  -f ${m2libc}/amd64/linux/fcntl.c \
  -f ${m2libc}/fcntl.c \
  -f ${m2libc}/amd64/linux/unistd.c \
  -f ${m2libc}/amd64/linux/sys/stat.c \
  -f ${m2libc}/ctype.c \
  -f ${m2libc}/stdlib.c \
  -f ${m2libc}/stdarg.h \
  -f ${m2libc}/stdio.h \
  -f ${m2libc}/stdio.c \
  -f ${m2libc}/string.c \
  -f ${m2libc}/bootstrappable.c \
  -f ${src}/mescc-tools-extra/mkdir.c \
  --debug \
  -o mkdir.M1

${blood-elf-0} --little-endian --64 -f mkdir.M1 -o mkdir-footer.M1

${M1} --architecture amd64 \
  --little-endian \
  -f ${m2libc}/amd64/amd64_defs.M1 \
  -f ${m2libc}/amd64/libc-full.M1 \
  -f mkdir.M1 \
  -f mkdir-footer.M1 \
  -o mkdir.hex2

${hex2} --architecture amd64 \
  --little-endian \
  -f ${m2libc}/amd64/ELF-amd64-debug.hex2 \
  -f mkdir.hex2 \
  --base-address 0x00600000 \
  -o ${out}
